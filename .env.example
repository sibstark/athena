QDRANT_VERSION=v1.18.2
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=methodology_e5_small_v1

# The documented cpu-arm64-1.9 tag was not published in GHCR as of 2026-07-16.
# Use the official amd64 image under Docker emulation on Apple Silicon.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9@sha256:ad950d30878eceb72aaf32024d26fa2b1d04a75304fa0b4776b49aa1941fea07
TEI_PLATFORM=linux/amd64
TEI_IMAGE_DIGEST=sha256:ad950d30878eceb72aaf32024d26fa2b1d04a75304fa0b4776b49aa1941fea07
TEI_PORT=8080
TEI_URL=http://127.0.0.1:8080
TEI_MODEL_ID=Xenova/multilingual-e5-small
TEI_MODEL_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
TEI_POOLING=mean
TEI_NORMALIZE=true
TEI_AUTO_TRUNCATE=false
TEI_BACKEND=onnxruntime
HF_TOKEN=

# Go RAG API. Generate long random values locally; never commit .env.
RAG_API_PORT=8090
# Bearer token for internal CLI and machine clients only.
RAG_API_KEY=
# Bitrix24 Chat Bots 2.0 webhook adapter. Required only when bitrix-bot is enabled.
BITRIX_BOT_PORT=8080
BITRIX_WEBHOOK_PATH=/webhook
BITRIX_APPLICATION_TOKEN=
BITRIX_REST_WEBHOOK_URL=
BITRIX_BOT_ID=
BITRIX_BOT_TOKEN=
RAG_API_URL=http://rag-api:8080
BITRIX_BOT_COLLECTION=methodology_e5_small_v1
BOT_REQUEST_TIMEOUT_MS=75000

AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL=24h
AUTH_COOKIE_SECURE=false
# Host-run address. Compose overrides this to :8080 inside the container.
HTTP_ADDR=:8090
HTTP_MAX_BODY_BYTES=1048576
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# React/Vite web client. Browser requests authenticate only with athena_session cookie.
WEB_PORT=3000
RAG_API_DEV_TARGET=http://127.0.0.1:8090

# Production HTTPS via umputun/nginx-le. Requires public DNS and ports 80/443.
LETSENCRYPT=true
LE_FQDN=devgames.hwschool.online
LE_EMAIL=admin@example.com
TZ=UTC

TEI_TIMEOUT=10s
QDRANT_TIMEOUT=10s

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60s
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_MAX_CONCURRENCY=4

RAG_DEFAULT_TOP_K=8
RAG_MAX_TOP_K=20
RAG_SCORE_THRESHOLD=0.65
RAG_MAX_QUERY_CHARS=4000
RAG_MAX_CONTEXT_CHARS=30000
RAG_MAX_CONTEXT_CHUNKS=8

QDRANT_COLLECTION=methodology_e5_small_v1
INDEXER_BATCH_SIZE=16
EMBEDDING_PIPELINE_VERSION=1
EMBEDDING_VECTOR_CACHE_SIZE=256
STORE_EMBEDDING_TEXT=false
LOG_LEVEL=info

BITRIX_WEBHOOK_URL=https://portal.bitrix24.ru/rest/USER_ID/WEBHOOK_SECRET/

# Indexer (external services are started separately)
TEI_URL=http://127.0.0.1:8080
TEI_TIMEOUT=120s

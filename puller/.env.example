# Create an incoming Bitrix24 webhook with the `note` permission.
# Keep the trailing slash. Never commit the real value.
BITRIX_WEBHOOK_URL=https://hwschool.bitrix24.ru/rest/USER_ID/WEBHOOK_SECRET/

# Local embeddings and Qdrant
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DTYPE=q8
EMBEDDING_MODEL_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
EMBEDDING_CACHE_DIR=var/models
EMBEDDING_PIPELINE_VERSION=1
EMBEDDING_VECTOR_CACHE_SIZE=256
STORE_EMBEDDING_TEXT=false

QDRANT_VERSION=v1.18.2
QDRANT_PORT=6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=methodology_e5_small_v1

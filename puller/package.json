{
  "name": "@athena/puller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "description": "Export Bitrix24 Knowledge Base 2.0 collections",
  "bin": { "puller": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "bun src/cli.ts",
    "pull": "bun src/cli.ts export",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "bun": ">=1.3.0" },
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.2.3",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}

{
  "name": "athena",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.0",
  "scripts": {
    "db:up": "docker compose up -d qdrant",
    "db:down": "docker compose stop qdrant",
    "db:logs": "docker compose logs -f qdrant",
    "db:status": "docker compose ps qdrant",
    "tei:prepare": "bun tei/src/prepare-model.ts",
    "tei:up": "bun run tei:prepare && docker compose up -d --force-recreate embeddings",
    "tei:down": "docker compose stop embeddings",
    "tei:logs": "docker compose logs -f embeddings",
    "tei:status": "docker compose ps embeddings",
    "rag:search:tei": "bun tei/src/cli-search.ts",
    "rag:compat:tei": "bun tei/src/cli-compat.ts",
    "api:run": "cd api && GOTOOLCHAIN=go1.26.4 go run ./cmd/server",
    "api:hash-password": "cd api && GOTOOLCHAIN=go1.26.4 go run ./cmd/hash-password",
    "api:test": "cd api && GOTOOLCHAIN=go1.26.4 go test ./...",
    "api:test:integration": "cd api && RUN_API_INTEGRATION=1 GOTOOLCHAIN=go1.26.4 go test ./...",
    "api:test:deepseek": "cd api && RUN_DEEPSEEK_INTEGRATION=1 GOTOOLCHAIN=go1.26.4 go test ./...",
    "api:build": "cd api && GOTOOLCHAIN=go1.26.4 go build ./cmd/server",
    "api:up": "docker compose up -d --build api",
    "api:down": "docker compose stop api",
    "api:logs": "docker compose logs -f api",
    "api:status": "docker compose ps api",
    "web:dev": "cd web && bun run dev",
    "web:test": "cd web && bun run test",
    "web:build": "cd web && bun run build",
    "web:up": "docker compose up -d --build web",
    "web:down": "docker compose stop web",
    "web:logs": "docker compose logs -f web",
    "web:status": "docker compose ps web",
    "https:up": "docker compose --profile https up -d --build https-proxy",
    "https:down": "docker compose --profile https stop https-proxy",
    "https:logs": "docker compose --profile https logs -f https-proxy",
    "https:status": "docker compose --profile https ps https-proxy"
  }
}

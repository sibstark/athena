{
  "name": "@athena/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "rag:index": "bun src/cli.ts",
    "test": "vitest run",
    "test:indexer:integration": "RUN_QDRANT_INTEGRATION=1 vitest run tests/indexer.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@qdrant/js-client-rest": "1.18.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
